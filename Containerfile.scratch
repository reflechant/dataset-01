ARG UBERJAR_PATH
FROM ghcr.io/graalvm/native-image-community:21-muslib AS native-builder
WORKDIR /app
ARG UBERJAR_PATH
COPY ${UBERJAR_PATH} app.jar
RUN native-image --static --libc=musl --initialize-at-build-time -jar app.jar -H:Name=dataset-01 --no-fallback

FROM scratch
COPY --from=native-builder /app/dataset-01 /dataset-01
ENTRYPOINT ["/dataset-01"]

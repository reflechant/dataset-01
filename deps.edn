{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        techascent/tech.ml.dataset {:mvn/version "8.026"}
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}}
 :aliases
 {:run-m {:main-opts ["-m" "reflechant.dataset-01"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build
          :exec-fn build-uber}
  :native {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
           :ns-default build
           :exec-fn native}
  :native-linux {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                 :ns-default build
                 :exec-fn native-linux}
  :container-scratch {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                      :ns-default build
                      :exec-fn container-scratch}
  :container-distroless {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                         :ns-default build
                         :exec-fn container-distroless}
  :desktop {:extra-deps {cljfx/cljfx {:mvn/version "1.10.362"
                                      :exclusions [org.openjfx/javafx-controls
                                                   org.openjfx/javafx-graphics
                                                   org.openjfx/javafx-base
                                                   org.openjfx/javafx-media
                                                   org.openjfx/javafx-web]}
                         org.openjfx/javafx-controls {:mvn/version "21.0.12" :mvn/classifier "linux"}
                         org.openjfx/javafx-graphics {:mvn/version "21.0.12" :mvn/classifier "linux"}
                         org.openjfx/javafx-base {:mvn/version "21.0.12" :mvn/classifier "linux"}}
            :main-opts ["-m" "reflechant.desktop"]}
  :jfx-linux {:override-deps {org.openjfx/javafx-controls {:mvn/version "21.0.12" :mvn/classifier "linux"}
                              org.openjfx/javafx-graphics {:mvn/version "21.0.12" :mvn/classifier "linux"}
                              org.openjfx/javafx-base {:mvn/version "21.0.12" :mvn/classifier "linux"}}}
  :jfx-mac {:override-deps {org.openjfx/javafx-controls {:mvn/version "21.0.12" :mvn/classifier "mac"}
                            org.openjfx/javafx-graphics {:mvn/version "21.0.12" :mvn/classifier "mac"}
                            org.openjfx/javafx-base {:mvn/version "21.0.12" :mvn/classifier "mac"}}}
  :jfx-mac-aarch64 {:override-deps {org.openjfx/javafx-controls {:mvn/version "21.0.12" :mvn/classifier "mac-aarch64"}
                                    org.openjfx/javafx-graphics {:mvn/version "21.0.12" :mvn/classifier "mac-aarch64"}
                                    org.openjfx/javafx-base {:mvn/version "21.0.12" :mvn/classifier "mac-aarch64"}}}
  :jfx-win {:override-deps {org.openjfx/javafx-controls {:mvn/version "21.0.12" :mvn/classifier "win"}
                            org.openjfx/javafx-graphics {:mvn/version "21.0.12" :mvn/classifier "win"}
                            org.openjfx/javafx-base {:mvn/version "21.0.12" :mvn/classifier "win"}}}
  :native-desktop {:extra-deps {cljfx/cljfx {:mvn/version "1.10.362"
                                             :exclusions [org.openjfx/javafx-controls
                                                          org.openjfx/javafx-graphics
                                                          org.openjfx/javafx-base
                                                          org.openjfx/javafx-media
                                                          org.openjfx/javafx-web]}}
                   :main-opts ["-m" "reflechant.desktop"]}}}

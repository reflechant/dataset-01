{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "calva": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${HOME}/.config/calva/backseat-driver/calva-mcp-server.js",
        ".calva/mcp-server/port"
      ],
      "timeout": 2000
    },
    "clojure-mcp": {
      "type": "stdio",
      "command": "clojure",
      "args": [
        "-Tmcp",
        "start",
        ":config-profile",
        ":cli-assist",
        ":fallback-nrepl",
        "true"
      ]
    }
  }
}
